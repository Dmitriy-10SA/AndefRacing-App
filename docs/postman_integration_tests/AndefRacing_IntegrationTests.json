				{
					"name": "01. Регистрация клиента",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const suffix = Math.floor(1000000 + Math.random() * 8999999).toString();",
									"const phone = '+7-9' + suffix.slice(0,2) + '-' + suffix.slice(2,5) + '-' + suffix.slice(5,7) + '-' + suffix.slice(0,2);",
									"pm.environment.set('clientPhone', phone);",
									"pm.environment.set('clientName', 'Postman Test Client ' + suffix);",
									"pm.environment.set('clientPassword', 'Password123!');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Статус ответа 2xx', function () {",
									"    pm.expect(pm.response.code).to.be.within(200, 299);",
									"});",
									"",
									"pm.test('Ответ содержит JWT клиента', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.jwt).to.be.a('string').and.not.empty;",
									"    pm.environment.set('clientToken', json.jwt);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Version",
								"value": "1.0.0"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{clientName}}\",\n  \"phone\": \"{{clientPhone}}\",\n  \"password\": \"{{clientPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/client/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"client",
								"register"
							]
						},
